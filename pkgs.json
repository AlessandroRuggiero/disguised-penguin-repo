{
    "bash": {
        "container": "bash:latest",
        "configmounts": {
            "bashuser": "/root/"
        }
    },
    "claude": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/claude:main",
        "configmounts": {
            "claudehome": "/home/penguin/"
        }
    },
    "firebase": 
    {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/firebase:main",
        "configmounts": {
            "config": "/home/penguin/.config/"
        },
        "portmappings": {
            "9005": "9005"
        }
    },
    "opencode": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/opencode:main",
        "configmounts": {
            "opencodeconfig": "/home/penguin/.local/share/opencode/"
        }
    },
    "gcloud": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/gcloud:main",
        "configmounts": {
            "gcloudconfig": "/home/penguin/.config/gcloud/"
        }
    },
    "doctl": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/doctl:main",
        "configmounts": {
            "doctlconfig": "/home/penguin/.config/doctl/"
        }
    },
    "gemini": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/gemini:main",
        "configmounts": {
            "geminiconfig": "/home/penguin/.gemini/"
        }
    },
    "gh": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/gh:main",
        "configmounts": {
            "ghconfig": "/home/penguin/.config/gh/"
        }
    }
    ,
    "yt-dlp": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/yt-dlp:main",
        "configmounts": {
            "yt-dlp-config": "/home/penguin/.config/yt-dlp/"
        }
    },
    "flutter": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/flutter:main",
        "configmounts": {
            "pubcache": "/home/penguin/.pub-cache/",
            "flutterconfig": "/home/penguin/.config/flutter/",
            "androidconfig": "/home/penguin/.android/"
        }
    },
    "codex": {
        "container": "ghcr.io/alessandroruggiero/disguised-penguin-repo/codex:main",
        "configmounts": {
            "codexconfig": "/home/penguin/.codex/"
        }
    }
}